generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ROLE {
  USER
  ADMIN
}

enum PROMOTYPE {
  FIXED
  PERCENTAGE
}

enum PROMOTIONRULE {
  NEWMEMBER
  WEEKDAY
  DATE_RANGE // for special days
}

model Promotions {
  id           String        @id @default(uuid())
  name         String
  type         PROMOTYPE
  value        Int // PERCENTAGE  10 = 10% , FIXED 5000  = Rp.5000
  rule         PROMOTIONRULE
  weekday      Int? // 1 = monday  7 = sunday
  startsAt     DateTime?
  endsAt       DateTime?
  newMembersAt Int? // member new for N days (default 30)
  maxDiscount  Int? // cap for discounts percentage
  minSubTotal  Int?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
}

model Profile {
  id        String   @id @db.Uuid
  username  String?
  phone     String?
  role      ROLE     @default(USER)
  createdAt DateTime @default(now())
}

model Category {
  id       String     @id @default(uuid())
  name     String
  products Products[]

  @@map("categories")
}

model Products {
  id          String            @id @default(uuid())
  categoryId  String
  name        String
  description String?
  base_price  Int
  image       String
  isActive    Boolean           @default(true)
  categories  Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updataAt    DateTime          @updatedAt
  variants    ProductVariants[]

  @@map("products")
}

model ProductVariants {
  id          Int      @id @default(autoincrement())
  productId   String
  product     Products @relation(fields: [productId], references: [id], onDelete: Cascade)
  label       String
  price_delta Int      @default(0)
}
